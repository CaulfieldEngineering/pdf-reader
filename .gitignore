# Dependencies and build output
node_modules/
out/
dist/
release/
*.tsbuildinfo

# Generated at build time (copied from pdfjs-dist)
src/renderer/public/pdfjs/

# Scratch files
.scratch/

# Voice model files are downloaded on first run to the app's user data folder
*.onnx
models/

# Documents: never commit PDFs, except generated test fixtures
*.pdf
!tests/fixtures/*.pdf

# Audio and images, except the icon set and docs screenshots
*.wav
*.png
!build/*.png
!build/icons/*.png
!docs/*.png

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Old Python prototype leftovers
.venv/
__pycache__/
